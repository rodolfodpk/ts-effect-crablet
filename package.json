{
  "name": "ts-effect-crablet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test:unit": "bun test packages/*/test/*.test.ts",
    "test:unit:coverage": "bun test --coverage --coverage-reporter=lcov packages/*/test/*.test.ts",
    "test:integration": "node --test \"packages/*/test/integration/*.test.ts\" \"examples/*/test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "typescript": "6.0.3"
  }
}
