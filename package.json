{
  "name": "ts-effect-crablet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "test:unit": "bun test packages/*/test/*.test.ts",
    "test:unit:coverage": "bun test --coverage --coverage-reporter=lcov packages/*/test/*.test.ts",
    "test:integration": "node --experimental-strip-types --test \"packages/*/test/integration/*.test.ts\" \"examples/*/test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.0",
    "@types/pg": "8.20.0",
    "typescript": "6.0.3"
  }
}
