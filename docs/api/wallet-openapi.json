  },
  "components": {
    "schemas": {
      "ViewsUnavailableEncoded": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:crablet:problem:read:views-unavailable"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Service Unavailable"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              503
            ]
          },
          "detail": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "lagging",
