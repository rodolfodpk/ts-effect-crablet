            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exposedCommands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "commandType": {
                            "type": "string"
                          },
                          "inputSchema": {}
                        },
                        "required": [
                          "commandType",
                          "inputSchema"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
