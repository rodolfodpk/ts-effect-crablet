    "/api/wallets/{walletId}": {
      "get": {
        "tags": [
          "walletQueries"
        ],
        "operationId": "walletQueries.getWallet",
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "consistentWith",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Read at least as fresh as a write: the `marker` a command returned (`\"<transactionId>:<position>\"`), or `latest` for everything committed when the request arrived. Waits for the views this read uses."
            },
            "required": false
          },
          {
            "name": "consistency",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "What to do if a view has not caught up in time: `strict` fails with 503, `bounded` answers anyway with the header `Crablet-Consistency: stale`, `eventual` does not wait. A request may ask for a stricter mode than the endpoint's, and a looser one only where the server allows it."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait for the views, in milliseconds (a whole number from 1 up to the endpoint's maximum)."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "walletId": {
                      "type": "string"
                    },
                    "owner": {
                      "type": "string"
                    },
                    "balance": {
                      "type": "number"
                    },
                    "lastUpdatedAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "walletId",
                    "owner",
                    "balance",
                    "lastUpdatedAt"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "crablet-consistency": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "stale"
                  ]
                },
                "required": false
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "404": {
            "description": "WalletNotFoundProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletNotFoundProblemEncoded"
                }
              }
            }
          },
          "503": {
            "description": "ViewsUnavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewsUnavailableEncoded"
                }
              }
            },
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string",
                  "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
                },
                "required": false
              }
            }
          }
        }
      }
    },
    "/api/wallets/{walletId}/transactions": {
      "get": {
        "tags": [
          "walletQueries"
        ],
        "operationId": "walletQueries.getWalletTransactions",
        "parameters": [
          {
            "name": "walletId",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How many transactions to return: a whole number from 1 to 100 (default 20)."
            },
            "required": false
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Return the transactions after this cursor: the `next` of the previous page. Opaque to clients."
            },
            "required": false
          },
          {
            "name": "consistentWith",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Read at least as fresh as a write: the `marker` a command returned (`\"<transactionId>:<position>\"`), or `latest` for everything committed when the request arrived. Waits for the views this read uses."
            },
            "required": false
          },
          {
            "name": "consistency",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "What to do if a view has not caught up in time: `strict` fails with 503, `bounded` answers anyway with the header `Crablet-Consistency: stale`, `eventual` does not wait. A request may ask for a stricter mode than the endpoint's, and a looser one only where the server allows it."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait for the views, in milliseconds (a whole number from 1 up to the endpoint's maximum)."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transactions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "transactionId": {
                            "type": "string"
                          },
                          "walletId": {
                            "type": "string"
                          },
                          "eventType": {
                            "type": "string"
                          },
                          "amount": {
                            "type": "number"
                          },
                          "description": {
                            "type": "string"
                          },
                          "occurredAt": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "transactionId",
                          "walletId",
                          "eventType",
                          "amount",
                          "description",
                          "occurredAt"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "transactions",
                    "next"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "crablet-consistency": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "stale"
                  ]
                },
                "required": false
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "404": {
            "description": "WalletNotFoundProblem",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletNotFoundProblemEncoded"
                }
              }
            }
          },
          "503": {
            "description": "ViewsUnavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewsUnavailableEncoded"
                }
              }
            },
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string",
                  "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
                },
                "required": false
              }
            }
          }
        }
      }
    },
