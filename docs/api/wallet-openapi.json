        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "walletId": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string",
                    "allOf": [
                      {
                        "x-personal": true
                      }
                    ]
                  },
                  "initialBalance": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "walletId",
                  "owner",
                  "initialBalance"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
