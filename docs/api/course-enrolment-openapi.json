{
  "openapi": "3.1.0",
  "info": {
    "title": "Course Enrolment API",
    "version": "1.0.0",
    "description": "Define courses and subscribe students: a course holds at most `capacity` students, a student takes at most 3 courses."
  },
  "paths": {
    "/api/commands": {
      "get": {
        "tags": [
          "commands"
        ],
        "operationId": "commands.listExposedCommands",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "exposedCommands": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "commandType": {
                            "type": "string"
                          },
                          "inputSchema": {}
                        },
                        "required": [
                          "commandType",
                          "inputSchema"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "exposedCommands"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/commands/define_course": {
      "post": {
        "tags": [
          "commands"
        ],
        "operationId": "commands.execute_define_course",
        "parameters": [
          {
            "name": "waitFor",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Wait for this view to process the write before responding, so a following read is not stale. One of: course-seats-view."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait, in milliseconds (whole number, 1 to 30000; default 5000). Needs waitFor."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "CommandIdempotent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandIdempotent"
                }
              }
            }
          },
          "201": {
            "description": "CommandCreated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandCreated"
                }
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "409": {
            "description": "CommandConflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandConflictEncoded"
                }
              }
            }
          },
          "500": {
            "description": "CommandApiUnexpectedError",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiUnexpectedErrorEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "courseId": {
                    "type": "string"
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "courseId",
                  "capacity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/commands/subscribe": {
      "post": {
        "tags": [
          "commands"
        ],
        "operationId": "commands.execute_subscribe",
        "parameters": [
          {
            "name": "waitFor",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Wait for this view to process the write before responding, so a following read is not stale. One of: course-seats-view."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait, in milliseconds (whole number, 1 to 30000; default 5000). Needs waitFor."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "CommandIdempotent",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandIdempotent"
                }
              }
            }
          },
          "201": {
            "description": "CommandCreated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandCreated"
                }
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "404": {
            "description": "CourseNotFoundProblem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseNotFoundProblem"
                }
              }
            }
          },
          "409": {
            "description": "CommandConflict | CourseFullProblem | StudentAtLimitProblem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/CommandConflictEncoded"
                    },
                    {
                      "$ref": "#/components/schemas/CourseFullProblem"
                    },
                    {
                      "$ref": "#/components/schemas/StudentAtLimitProblem"
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "CommandApiUnexpectedError",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiUnexpectedErrorEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "studentId": {
                    "type": "string"
                  },
                  "courseId": {
                    "type": "string"
                  }
                },
                "required": [
                  "studentId",
                  "courseId"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/courses/{courseId}": {
      "get": {
        "tags": [
          "courseQueries"
        ],
        "operationId": "courseQueries.getCourse",
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          },
          {
            "name": "consistentWith",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Read at least as fresh as a write: the `marker` a command returned (`\"<transactionId>:<position>\"`), or `latest` for everything committed when the request arrived. Waits for the views this read uses."
            },
            "required": false
          },
          {
            "name": "consistency",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "What to do if a view has not caught up in time: `strict` fails with 503, `bounded` answers anyway with the header `Crablet-Consistency: stale`, `eventual` does not wait. A request may ask for a stricter mode than the endpoint's, and a looser one only where the server allows it."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait for the views, in milliseconds (a whole number from 1 up to the endpoint's maximum)."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "courseId": {
                      "type": "string"
                    },
                    "capacity": {
                      "type": "integer"
                    },
                    "subscribers": {
                      "type": "integer"
                    },
                    "seatsLeft": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "courseId",
                    "capacity",
                    "subscribers",
                    "seatsLeft"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "crablet-consistency": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "stale"
                  ]
                },
                "required": false
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "404": {
            "description": "CourseNotFoundProblem",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseNotFoundProblem"
                }
              }
            }
          },
          "503": {
            "description": "ViewsUnavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewsUnavailableEncoded"
                }
              }
            },
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string",
                  "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
                },
                "required": false
              }
            }
          }
        }
      }
    },
    "/api/courses": {
      "get": {
        "tags": [
          "courseQueries"
        ],
        "operationId": "courseQueries.listCourses",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How many courses to return: a whole number from 1 to 100 (default 20)."
            },
            "required": false
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Return the courses after this cursor: the `next` of the previous page. Opaque to clients."
            },
            "required": false
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Only courses whose id starts with this text (case-sensitive)."
            },
            "required": false
          },
          {
            "name": "consistentWith",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "Read at least as fresh as a write: the `marker` a command returned (`\"<transactionId>:<position>\"`), or `latest` for everything committed when the request arrived. Waits for the views this read uses."
            },
            "required": false
          },
          {
            "name": "consistency",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "What to do if a view has not caught up in time: `strict` fails with 503, `bounded` answers anyway with the header `Crablet-Consistency: stale`, `eventual` does not wait. A request may ask for a stricter mode than the endpoint's, and a looser one only where the server allows it."
            },
            "required": false
          },
          {
            "name": "waitTimeout",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "How long to wait for the views, in milliseconds (a whole number from 1 up to the endpoint's maximum)."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "courseId": {
                            "type": "string"
                          },
                          "capacity": {
                            "type": "integer"
                          },
                          "subscribers": {
                            "type": "integer"
                          },
                          "seatsLeft": {
                            "type": "integer"
                          }
                        },
                        "required": [
                          "courseId",
                          "capacity",
                          "subscribers",
                          "seatsLeft"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "next": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "next"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "headers": {
              "crablet-consistency": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "stale"
                  ]
                },
                "required": false
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          },
          "503": {
            "description": "ViewsUnavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewsUnavailableEncoded"
                }
              }
            },
            "headers": {
              "retry-after": {
                "schema": {
                  "type": "string",
                  "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$"
                },
                "required": false
              }
            }
          }
        }
      }
    },
    "/api/views/changes": {
      "get": {
        "tags": [
          "courseFeed"
        ],
        "operationId": "courseFeed.viewChanges",
        "parameters": [
          {
            "name": "views",
            "in": "query",
            "schema": {
              "type": "string",
              "description": "The views to watch, comma-separated (for example `course-seats-view`). One connection can watch several."
            },
            "required": true
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "event": {
                      "type": "string"
                    },
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "x-effect-stream": {
                  "encoding": "sse",
                  "causeSchema": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Fail"
                              ]
                            },
                            "error": {
                              "not": {}
                            }
                          },
                          "required": [
                            "_tag",
                            "error"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Die"
                              ]
                            },
                            "defect": {}
                          },
                          "required": [
                            "_tag",
                            "defect"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "_tag": {
                              "type": "string",
                              "enum": [
                                "Interrupt"
                              ]
                            },
                            "fiberId": {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "_tag",
                            "fiberId"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "errorSchema": {
                    "not": {}
                  },
                  "failureEvent": "effect/http-api/stream/failure"
                }
              }
            }
          },
          "400": {
            "description": "CommandApiBadRequest",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandApiBadRequestEncoded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandApiBadRequestEncoded": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:crablet:problem:command-api:bad-request"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Bad Request"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              400
            ]
          },
          "detail": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InputIssue"
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "InputIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "description": "Where in the request body: property names and array indexes, outermost first."
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "ViewsUnavailableEncoded": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:crablet:problem:read:views-unavailable"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Service Unavailable"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              503
            ]
          },
          "detail": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "lagging",
              "view_failed"
            ]
          },
          "views": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UncaughtView"
            }
          },
          "retryAfterSeconds": {
            "type": "integer"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "reason",
          "views"
        ],
        "additionalProperties": false
      },
      "UncaughtView": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "lagging",
              "view_failed"
            ]
          },
          "reachedPosition": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "reason",
          "reachedPosition"
        ],
        "additionalProperties": false
      },
      "CourseNotFoundProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "enum": [
              "Not Found"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              404
            ]
          },
          "detail": {
            "type": "string"
          },
          "errorType": {
            "type": "string",
            "enum": [
              "CourseNotFound"
            ]
          },
          "fields": {
            "type": "object",
            "properties": {
              "courseId": {
                "type": "string"
              }
            },
            "required": [
              "courseId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "errorType",
          "fields"
        ],
        "additionalProperties": false
      },
      "CommandApiUnexpectedErrorEncoded": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:crablet:problem:command-api:unexpected-error"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Internal Server Error"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              500
            ]
          },
          "detail": {
            "type": "string",
            "enum": [
              "Unexpected command API error"
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail"
        ],
        "additionalProperties": false
      },
      "StudentAtLimitProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "enum": [
              "Conflict"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              409
            ]
          },
          "detail": {
            "type": "string"
          },
          "errorType": {
            "type": "string",
            "enum": [
              "StudentAtLimit"
            ]
          },
          "fields": {
            "type": "object",
            "properties": {
              "studentId": {
                "type": "string"
              },
              "limit": {
                "type": "integer"
              }
            },
            "required": [
              "studentId",
              "limit"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "errorType",
          "fields"
        ],
        "additionalProperties": false
      },
      "CourseFullProblem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "enum": [
              "Conflict"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              409
            ]
          },
          "detail": {
            "type": "string"
          },
          "errorType": {
            "type": "string",
            "enum": [
              "CourseFull"
            ]
          },
          "fields": {
            "type": "object",
            "properties": {
              "courseId": {
                "type": "string"
              },
              "capacity": {
                "type": "integer"
              }
            },
            "required": [
              "courseId",
              "capacity"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "errorType",
          "fields"
        ],
        "additionalProperties": false
      },
      "CommandConflictEncoded": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "urn:crablet:problem:command-api:dcb-concurrency"
            ]
          },
          "title": {
            "type": "string",
            "enum": [
              "Conflict"
            ]
          },
          "status": {
            "type": "number",
            "enum": [
              409
            ]
          },
          "detail": {
            "type": "string"
          },
          "violationCode": {
            "type": "string"
          },
          "hint": {
            "type": "string",
            "enum": [
              "Refresh state and retry the command if it is still valid."
            ]
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "violationCode",
          "hint"
        ],
        "additionalProperties": false
      },
      "CommandIdempotent": {
        "type": "object",
